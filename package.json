{
  "name": "digimon-tamers-blue-card",
  "version": "0.2.2",
  "private": true,
  "license": "UNLICENSED",
  "description": "디지몬 테이머즈 기반 모바일 덱빌딩 로그라이크 (비공식 팬 게임)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/upper-drive.mjs vite",
    "build": "node scripts/upper-drive.mjs vite build",
    "preview": "node scripts/upper-drive.mjs vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node scripts/upper-drive.mjs vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "card-texts": "tsx scripts/card-texts.ts",
    "sim": "tsx src/sim/cli.ts",
    "e2e": "node scripts/upper-drive.mjs scripts/e2e/battle.mjs",
    "cap:sync": "npm run build && cap sync android"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  }
}
